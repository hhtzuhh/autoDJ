MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_API_BASE=https://api.meta.ai/v1
META_TIMEOUT_SECONDS=30
META_REASONING_EFFORT=low
META_MAX_TOKENS=2048
# Set curation only; one larger-budget retry on truncated output (cap 8192).
META_CURATOR_MAX_TOKENS=4096
META_CURATOR_TIMEOUT_SECONDS=60
# Optional manual-upload observation artifacts; ignored locally by default.
CROWD_ARTIFACTS_DIR=.local/crowd
